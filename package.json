{
  "name": "weather-compare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:app": "node scripts/build-app.js",
    "build:icons": "node scripts/build-icons.js",
    "app:sync": "npm run build:app && npx cap sync android",
